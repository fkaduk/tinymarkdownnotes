# Password for creating new notes (required)
NOTES_ADMIN_KEY=change-me-in-production
# Host directory mounted into the container
DATA_DIR=data
# Host-only app listener (Caddy reaches the app over Docker's network)
NOTES_BIND_ADDRESS=127.0.0.1
NOTES_PORT=5000
# Uncomment these two lines to enable the production Caddy proxy
# COMPOSE_PROFILES=production
# Domain name used by Caddy in production
DOMAIN=yourdomain.com
